---
import '../styles/global.css';
import Boot from '../components/Boot.astro';

interface Props {
  title?: string;
  description?: string;
  /** ステータスラインに出すファイル名 */
  file: string;
  /** コマンド行に出す Vim 風のファイル情報(例: 93L, 4321B)。省略時は [RO] */
  stat?: string;
  active?: 'home' | 'archive' | 'units' | 'profile';
  /** h キーの戻り先 */
  back?: string;
  type?: 'website' | 'article';
  /** OGP 画像のパス */
  image?: string;
}

const {
  title,
  description = 'バックエンドエンジニア fami-gb の記録データと制作ユニット。',
  file,
  stat = '[RO]',
  active,
  back,
  type = 'website',
  image = '/og/index.png',
} = Astro.props;
const siteName = 'FAMI-GB';
const fullTitle = title ? `${title} - ${siteName}` : `${siteName} // 記録端末`;
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const tabs = [
  { key: 'home', label: 'HOME', href: '/' },
  { key: 'archive', label: 'ARCHIVE', href: '/blog/' },
  { key: 'units', label: 'UNITS', href: '/#units' },
  { key: 'profile', label: 'PROFILE', href: '/#profile' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@fami_gb1618" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap"
    />
  </head>
  <body data-back={back}>
    <Boot />
    <header class="site-header">
      <div class="top">
        <a href="/" class="logo">FAMI-GB</a>
        <span class="sys">SYSTEM // famigb-dev.com ── ONLINE</span>
      </div>
      <div class="double-rule"></div>
      <nav aria-label="メイン" class="tabs">
        {tabs.map((t) => <a href={t.href} class="tab" aria-current={t.key === active ? 'page' : undefined}>{t.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="hints">
        <slot name="hints">
          <span><kbd>j</kbd><kbd>k</kbd>選択</span>
          <span><kbd>l</kbd>決定</span>
          {back && <span><kbd>h</kbd>戻る</span>}
          <span><kbd>/</kbd>検索</span>
        </slot>
      </div>
      <div class="statusline">
        <span class="mode">NORMAL</span>
        <span>{file}</span>
        <span class="grow"></span>
        <span>utf-8</span>
        <span class="sep" id="pct">Top</span>
      </div>
      <div class="cmdline"><span id="echo">"{file}" {stat}</span><span class="cursor"></span></div>
    </footer>

    <dialog id="search" aria-labelledby="search-h">
      <div class="brk">
        <div class="panel-head">
          <h2 id="search-h" style="margin:0;font-size:inherit;font-weight:500">SEARCH // 記録検索</h2>
          <span id="hits" aria-live="polite"></span>
        </div>
        <div class="query">
          <label for="q">QUERY</label>
          <div class="field"><span aria-hidden="true">/</span><input id="q" type="search" autocomplete="off" /></div>
        </div>
        <ul class="list" id="results"></ul>
        <div class="hints">
          <span><kbd>↑</kbd><kbd>↓</kbd>選択</span>
          <span><kbd>Enter</kbd>開く</span>
          <span><kbd>Esc</kbd>閉じる</span>
        </div>
      </div>
    </dialog>

    <script>
      import { initKeys } from '../scripts/keys';
      initKeys();
    </script>
  </body>
</html>
