---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** ステータスラインに出すファイル名 */
  file: string;
  active?: 'home' | 'archive' | 'units' | 'profile';
  /** h キーの戻り先 */
  back?: string;
  type?: 'website' | 'article';
}

const { title, description = 'fami-gb のブログと制作物', file, active, back, type = 'website' } = Astro.props;
const siteName = "fami-gb's portfolio";
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const url = new URL(Astro.url.pathname, Astro.site);

const tabs = [
  { key: 'home', label: 'HOME', href: '/' },
  { key: 'archive', label: 'ARCHIVE', href: '/blog/' },
  { key: 'units', label: 'UNITS', href: '/#units' },
  { key: 'profile', label: 'PROFILE', href: '/#profile' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@fami_gb1618" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap"
    />
  </head>
  <body data-back={back}>
    <header class="site-header">
      <div class="top">
        <a href="/" class="logo">FAMI-GB</a>
        <span class="sys">SYSTEM // fami-gb.dev ── ONLINE</span>
      </div>
      <div class="double-rule"></div>
      <nav aria-label="メイン" class="tabs">
        {tabs.map((t) => <a href={t.href} class="tab" aria-current={t.key === active ? 'page' : undefined}>{t.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="hints">
        <slot name="hints">
          <span><kbd>j</kbd><kbd>k</kbd>選択</span>
          <span><kbd>l</kbd>決定</span>
          {back && <span><kbd>h</kbd>戻る</span>}
          <span><kbd>/</kbd>検索</span>
        </slot>
      </div>
      <div class="statusline">
        <span class="mode">NORMAL</span>
        <span>{file}</span>
        <span class="grow"></span>
        <span>utf-8</span>
        <span class="sep" id="pct">Top</span>
      </div>
      <div class="cmdline"><span id="echo"></span><span class="cursor"></span></div>
    </footer>

    <dialog id="search" aria-labelledby="search-h">
      <div class="brk">
        <div class="panel-head">
          <h2 id="search-h" style="margin:0;font-size:inherit;font-weight:500">SEARCH // 記録検索</h2>
          <span id="hits" aria-live="polite"></span>
        </div>
        <div class="query">
          <label for="q">QUERY</label>
          <div class="field"><span aria-hidden="true">/</span><input id="q" type="search" autocomplete="off" /></div>
        </div>
        <ul class="list" id="results"></ul>
        <div class="hints">
          <span><kbd>↑</kbd><kbd>↓</kbd>選択</span>
          <span><kbd>Enter</kbd>開く</span>
          <span><kbd>Esc</kbd>閉じる</span>
        </div>
      </div>
    </dialog>

    <script>
      import { initKeys } from '../scripts/keys';
      initKeys();
    </script>
  </body>
</html>
